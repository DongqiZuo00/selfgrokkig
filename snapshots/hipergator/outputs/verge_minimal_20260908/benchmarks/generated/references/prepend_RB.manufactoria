START start:
    NEXT marker
PAINTER_YELLOW marker:
    NEXT prefix_0
PAINTER_RED prefix_0:
    NEXT prefix_1
PAINTER_BLUE prefix_1:
    NEXT scan
PULLER_RB scan:
    [R] emit_r
    [B] emit_b
    [EMPTY] finish
PAINTER_BLUE emit_b:
    NEXT scan
PAINTER_RED emit_r:
    NEXT scan
PULLER_YG finish:
    [Y] end
    [G] NONE
    [EMPTY] NONE
END end
